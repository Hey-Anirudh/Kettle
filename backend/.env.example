# ============================================
# Redew Backend Configuration Template
# ============================================
# Copy this file to .env and fill in your keys
# cp .env.example .env

# Server Port (change if 8000 is taken)
PORT=8000

# Telegram Credentials (for music database)
# Get these from https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash
SESSION_STRING=your_session_string
YOU_MUSIC_SESSION=your_youmusic_session

# Database Channel (Telegram channel ID used as storage)
DATABASE_CHANNEL_ID=your_channel_id

# Spotify Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google OAuth Credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Public Database fallback
CHANNEL_USERNAME=@shakkydb
GROUP_USERNAME=shadowmusicbase
