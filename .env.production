# Baked into the production build (vite build / the packaged Electron app).
#
# API_BASE  — shared cloud backend (host for Jam rooms + shared account state)
# LOCAL_API — bundled on-device backend (YouTube extraction; bot-checked on cloud IPs)
# AUTH_API  — where Google Sign-In is served. Defaults to LOCAL_API.
#             Leave unset to use the bundled backend, or point at Render if you
#             wire up Google OAuth there (see src/config.js for instructions).
VITE_API_BASE=https://kettle-backend.onrender.com
