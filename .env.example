# Kettle frontend — production/development URL configuration
# Copy to .env.production and/or .env.development as needed.

# Shared cloud backend (accounts, playlists, likes, taste sync, JAM rooms)
VITE_API_BASE=https://kettle-backend.onrender.com

# Bundled on-device backend — used for search/recommendations/playback where
# YouTube/ extraction is blocked from cloud IPs. Defaults to 127.0.0.1:8000 if unset.
# VITE_LOCAL_API=http://127.0.0.1:8000

# Google Sign-In backend. Defaults to the cloud (see src/config.js).
# Render needs GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET + the Render callback
# URI in Google Cloud Console for sign-in to work there. Offline dev:
# VITE_AUTH_BASE=http://127.0.0.1:8000
